# Copy this file to .env and edit the values below:
#   cp .env.example .env

# Port the server listens on
PORT=3000

# Staff dashboard login — CHANGE THESE before going live
STAFF_USER=admin
STAFF_PASSWORD=change-this-password

# Long random string used to sign staff login sessions.
# If left empty, a new random one is generated every restart,
# which logs staff out whenever the server restarts.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# development | production
# In production: cookie gets the Secure flag (requires HTTPS) and
# Express trusts the first reverse-proxy hop for correct client IPs.
NODE_ENV=development
